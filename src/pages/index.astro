---
import Base from '@layouts/Base.astro';
import Nav from '@components/Nav.astro';
import Hero from '@components/Hero.astro';
import Ribbon from '@components/Ribbon.astro';
import AboutUs from '@components/AboutUs.astro';
import Philosophy from '@components/Philosophy.astro';
import ConfidentialWork from '@components/ConfidentialWork.astro';
import Pricing from '@components/Pricing.astro';
import Contact from '@components/Contact.astro';
import Footer from '@components/Footer.astro';
---

<Base lang="es" isHomepage={true}>
  <Nav lang="es" />

  <main id="main-content">
    <Hero lang="es" />
    <Ribbon lang="es" />
    <AboutUs lang="es" />
    <Philosophy lang="es" />
    <ConfidentialWork lang="es" />
    <Pricing lang="es" />
    <Contact lang="es" />
  </main>

  <Footer lang="es" />
</Base>
