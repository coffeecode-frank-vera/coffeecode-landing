---
import Base from '@layouts/Base.astro';
import Nav from '@components/Nav.astro';
import Hero from '@components/Hero.astro';
import Ribbon from '@components/Ribbon.astro';
import AboutUs from '@components/AboutUs.astro';
import Philosophy from '@components/Philosophy.astro';
import ConfidentialWork from '@components/ConfidentialWork.astro';
import Pricing from '@components/Pricing.astro';
import Contact from '@components/Contact.astro';
import Footer from '@components/Footer.astro';
---

<Base
  lang="en"
  title="Coffee Code — Craft Software Studio"
  description="End-to-end software development. Landing pages, custom applications, and technical consulting."
>
  <Nav lang="en" />

  <main id="main-content">
    <Hero lang="en" />
    <Ribbon lang="en" />
    <AboutUs lang="en" />
    <Philosophy lang="en" />
    <ConfidentialWork lang="en" />
    <Pricing lang="en" />
    <Contact lang="en" />
  </main>

  <Footer lang="en" />
</Base>
