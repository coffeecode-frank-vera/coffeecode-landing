---
import { ClientRouter } from 'astro:transitions';
import '@styles/tokens.css';
import '@styles/global.css';

export type Lang = 'es' | 'en';

interface Props {
  lang?: Lang;
  title?: string;
  description?: string;
}

const { lang = 'es' } = Astro.props;

const isEn = lang === 'en';

const title = isEn
  ? (Astro.props.title ?? 'Coffee Code — Craft Software Studio')
  : (Astro.props.title ?? 'Coffee Code — Craft Software Studio');

const description = isEn
  ? (Astro.props.description ?? 'Software studio based in Nogales, Sonora, México. End-to-end development: fixed-price landing pages, custom applications, and technical consulting.')
  : (Astro.props.description ?? 'Estudio de software en Nogales, Sonora, México. Desarrollamos sistemas de extremo a extremo — landing pages a precio fijo, aplicaciones a medida y consultoría técnica.');

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteOrigin = Astro.site ? Astro.site.origin : 'https://coffeecode.com.mx';

// Canonical URL for this specific language page
const canonicalUrl = isEn ? `${siteOrigin}${base}/en/` : `${siteOrigin}${base}/`;

// hreflang alternates
const hreflangEs = `${siteOrigin}${base}/`;
const hreflangEn = `${siteOrigin}${base}/en/`;

const ogImage = `${siteOrigin}${base}/og-image.png`;

const ogTitle = isEn
  ? 'Coffee Code — Craft Software Studio'
  : 'Coffee Code — Craft Software Studio';

const ogDescription = isEn
  ? 'End-to-end software development. Landing pages, custom applications, and technical consulting.'
  : 'Desarrollamos software de extremo a extremo. Landing pages, aplicaciones a medida y consultoría técnica.';

const skipLabel = isEn ? 'Skip to content' : 'Saltar al contenido';

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Coffee Code',
  url: `${siteOrigin}${base}/`,
  description: 'Craft software studio in Nogales, Sonora, México. End-to-end software development, technical consulting, and fixed-price landing pages.',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Nogales',
    addressRegion: 'Sonora',
    addressCountry: 'MX',
  },
  contactPoint: {
    '@type': 'ContactPoint',
    email: 'contact@coffeecode.com.mx',
    contactType: 'customer service',
  },
  areaServed: ['MX', 'US'],
  serviceType: ['Software Development', 'Technical Consulting', 'Landing Page Development'],
  sameAs: [
    'https://github.com/coffeecode-studio',
  ],
});
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <title>{title}</title>

    <!-- Canonical -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- hreflang alternates — tell Google both language versions exist -->
    <link rel="alternate" hreflang="es" href={hreflangEs} />
    <link rel="alternate" hreflang="en" href={hreflangEn} />
    <link rel="alternate" hreflang="x-default" href={hreflangEs} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}/site.webmanifest`} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={isEn ? 'en_US' : 'es_MX'} />
    <meta property="og:site_name" content="Coffee Code" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Theme bootstrap — runs before paint to prevent flash.
         Language is now static per page; only theme needs JS detection.
         astro:after-swap re-applies on every view-transition navigation. -->
    <script is:inline>
      function applyTheme() {
        const storedTheme = localStorage.getItem('theme');
        const sysLight = matchMedia('(prefers-color-scheme: light)').matches;
        const theme = storedTheme || (sysLight ? 'light' : 'dark');
        document.documentElement.setAttribute('data-theme', theme);
        document.documentElement.setAttribute('data-palette', 'arriesgado');
      }
      applyTheme();
      document.addEventListener('astro:after-swap', applyTheme);
    </script>

    <ClientRouter />

    <!-- Structured data -->
    <script type="application/ld+json" is:inline set:html={jsonLd} />
  </head>
  <body>
    <a href="#main-content" class="skip-link">{skipLabel}</a>
    <slot />
  </body>
</html>
