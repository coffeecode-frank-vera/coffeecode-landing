---
import '@styles/page.css';
import SectionHead from '@components/SectionHead.astro';
import type { Lang } from '@layouts/Base.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const isEn = lang === 'en';

// ─── SVG Diagrams ─────────────────────────────────────────────────────────
// Whiteboard-schematic style: single stroke weight, monospace labels,
// no skeuomorphism. currentColor for lines/boxes; var(--coffee) for accent
// nodes only. viewBox coordinates chosen for clean 320px-minimum scaling.

const diagrams = {

  // Case A — Municipal government: citizen app → API gateway → 5 services → shared postgres
  gov: `<svg viewBox="0 0 480 220" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="diag-gov-title diag-gov-desc">
  <title id="diag-gov-title">${isEn ? 'Municipal government system architecture' : 'Arquitectura del sistema de gobierno municipal'}</title>
  <desc id="diag-gov-desc">${isEn ? 'Citizen app connects to an API gateway serving 5 department services — tickets/SLA, procurement, asset disclosure, vehicle impound, and transition tools — all backed by a shared Postgres database. System has been in production for 8+ years across 2 administration changes.' : 'La app ciudadana se conecta a un API gateway que sirve 5 dependencias — tickets/SLA, compras, patrimonio, corralón y poderes — todas sobre una base de datos Postgres compartida. Sistema en producción 8+ años y dos cambios de administración.'}</desc>

  <!-- Citizen app -->
  <rect x="160" y="8" width="160" height="36" rx="5" stroke="currentColor" stroke-width="1.5" fill="var(--bg-elevated)"/>
  <text x="240" y="31" text-anchor="middle" font-family="IBM Plex Mono,monospace" font-size="12" fill="currentColor">${isEn ? 'citizen app' : 'app ciudadana'}</text>

  <!-- connector: app → gateway -->
  <line x1="240" y1="44" x2="240" y2="64" stroke="currentColor" stroke-width="1.5"/>
  <polygon points="235,60 240,68 245,60" fill="currentColor"/>

  <!-- API Gateway (coffee accent) — spans full service bus width -->
  <rect x="40" y="68" width="400" height="38" rx="5" stroke="var(--coffee)" stroke-width="1.5" fill="var(--bg-elevated)"/>
  <text x="240" y="91" text-anchor="middle" font-family="IBM Plex Mono,monospace" font-size="12" fill="var(--coffee)">API gateway</text>

  <!-- horizontal bus line from gateway — spans box centers 76..404 -->
  <line x1="76" y1="106" x2="404" y2="106" stroke="currentColor" stroke-width="1" stroke-dasharray="4 3"/>

  <!-- 5 drop lines: centers at x=76,158,240,322,404 -->
  <line x1="76"  y1="106" x2="76"  y2="122" stroke="currentColor" stroke-width="1" stroke-dasharray="4 3"/>
  <line x1="158" y1="106" x2="158" y2="122" stroke="currentColor" stroke-width="1" stroke-dasharray="4 3"/>
  <line x1="240" y1="106" x2="240" y2="122" stroke="currentColor" stroke-width="1" stroke-dasharray="4 3"/>
  <line x1="322" y1="106" x2="322" y2="122" stroke="currentColor" stroke-width="1" stroke-dasharray="4 3"/>
  <line x1="404" y1="106" x2="404" y2="122" stroke="currentColor" stroke-width="1" stroke-dasharray="4 3"/>

  <!-- 5 service boxes: width=72px, gap=10px, no overlaps -->
  <!-- box 1 x=40..112, center=76 -->
  <rect x="40"  y="122" width="72" height="32" rx="4" stroke="currentColor" stroke-width="1" fill="var(--bg-elevated)"/>
  <text x="76"  y="142" text-anchor="middle" font-family="IBM Plex Mono,monospace" font-size="9" fill="var(--text-secondary)">tickets/SLA</text>

  <!-- box 2 x=122..194, center=158 -->
  <rect x="122" y="122" width="72" height="32" rx="4" stroke="currentColor" stroke-width="1" fill="var(--bg-elevated)"/>
  <text x="158" y="142" text-anchor="middle" font-family="IBM Plex Mono,monospace" font-size="9" fill="var(--text-secondary)">${isEn ? 'procurement' : 'compras'}</text>

  <!-- box 3 x=204..276, center=240 -->
  <rect x="204" y="122" width="72" height="32" rx="4" stroke="currentColor" stroke-width="1" fill="var(--bg-elevated)"/>
  <text x="240" y="142" text-anchor="middle" font-family="IBM Plex Mono,monospace" font-size="9" fill="var(--text-secondary)">${isEn ? 'declaration' : 'patrimonio'}</text>

  <!-- box 4 x=286..358, center=322 -->
  <rect x="286" y="122" width="72" height="32" rx="4" stroke="currentColor" stroke-width="1" fill="var(--bg-elevated)"/>
  <text x="322" y="142" text-anchor="middle" font-family="IBM Plex Mono,monospace" font-size="9" fill="var(--text-secondary)">${isEn ? 'impound' : 'corralón'}</text>

  <!-- box 5 x=368..440, center=404 -->
  <rect x="368" y="122" width="72" height="32" rx="4" stroke="currentColor" stroke-width="1" fill="var(--bg-elevated)"/>
  <text x="404" y="142" text-anchor="middle" font-family="IBM Plex Mono,monospace" font-size="9" fill="var(--text-secondary)">${isEn ? 'transition' : 'poderes'}</text>

  <!-- connector: services → postgres -->
  <line x1="240" y1="154" x2="240" y2="174" stroke="currentColor" stroke-width="1.5"/>
  <polygon points="235,170 240,178 245,170" fill="currentColor"/>

  <!-- Postgres (shared) -->
  <rect x="148" y="178" width="184" height="34" rx="5" stroke="currentColor" stroke-width="1.5" fill="var(--bg-elevated)"/>
  <text x="240" y="200" text-anchor="middle" font-family="IBM Plex Mono,monospace" font-size="11" fill="var(--text-secondary)">postgres (shared)</text>
</svg>`,

  // Case B — Catalog e-commerce: image upload → Python detection → logo overlay → CDN, inside AWS region frame
  ecom: `<svg viewBox="0 0 480 118" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="diag-ecom-title diag-ecom-desc">
  <title id="diag-ecom-title">${isEn ? 'Catalog e-commerce image pipeline architecture' : 'Arquitectura del pipeline de imágenes para e-commerce'}</title>
  <desc id="diag-ecom-desc">${isEn ? 'Image upload flows into a Python detection pipeline microservice, which passes output to logo overlay, then delivers to CDN. All services run inside an AWS region.' : 'La carga de imagen pasa por un microservicio de detección en Python, luego a superposición de logo y finalmente se entrega al CDN. Todos los servicios corren dentro de una región AWS.'}</desc>

  <!-- AWS region frame -->
  <rect x="8" y="8" width="464" height="102" rx="8" stroke="currentColor" stroke-width="1" stroke-dasharray="6 4" fill="none" opacity="0.4"/>
  <text x="20" y="23" font-family="IBM Plex Mono,monospace" font-size="9" fill="var(--text-tertiary)" letter-spacing="0.05em">AWS region</text>

  <!-- 4 equal boxes: w=95, gap=20, left pad=20 → centers at 68, 183, 298, 413 -->
  <!-- All boxes: y=33, height=52, center y=59 -->

  <!-- Box 1: image upload -->
  <rect x="20" y="33" width="95" height="52" rx="5" stroke="currentColor" stroke-width="1.5" fill="var(--bg-elevated)"/>
  <text x="68" y="56" text-anchor="middle" font-family="IBM Plex Mono,monospace" font-size="11" fill="var(--text-secondary)">${isEn ? 'image' : 'imagen'}</text>
  <text x="68" y="71" text-anchor="middle" font-family="IBM Plex Mono,monospace" font-size="11" fill="var(--text-secondary)">upload</text>

  <!-- arrow 1→2 -->
  <line x1="115" y1="59" x2="133" y2="59" stroke="currentColor" stroke-width="1.5"/>
  <polygon points="129,54 137,59 129,64" fill="currentColor"/>

  <!-- Box 2: Python detection pipeline (coffee accent, taller) -->
  <rect x="135" y="22" width="95" height="74" rx="5" stroke="var(--coffee)" stroke-width="1.5" fill="var(--bg-elevated)"/>
  <text x="183" y="49" text-anchor="middle" font-family="IBM Plex Mono,monospace" font-size="11" fill="var(--coffee)">${isEn ? 'detection' : 'detección'}</text>
  <text x="183" y="64" text-anchor="middle" font-family="IBM Plex Mono,monospace" font-size="10" fill="var(--text-tertiary)">python pipeline</text>
  <text x="183" y="78" text-anchor="middle" font-family="IBM Plex Mono,monospace" font-size="10" fill="var(--text-tertiary)">(microservice)</text>

  <!-- arrow 2→3 -->
  <line x1="230" y1="59" x2="248" y2="59" stroke="currentColor" stroke-width="1.5"/>
  <polygon points="244,54 252,59 244,64" fill="currentColor"/>

  <!-- Box 3: logo overlay -->
  <rect x="250" y="33" width="95" height="52" rx="5" stroke="currentColor" stroke-width="1.5" fill="var(--bg-elevated)"/>
  <text x="298" y="56" text-anchor="middle" font-family="IBM Plex Mono,monospace" font-size="11" fill="var(--text-secondary)">logo</text>
  <text x="298" y="71" text-anchor="middle" font-family="IBM Plex Mono,monospace" font-size="11" fill="var(--text-secondary)">overlay</text>

  <!-- arrow 3→4 (code accent: pipeline output) -->
  <line x1="345" y1="59" x2="363" y2="59" stroke="var(--code)" stroke-width="1.5"/>
  <polygon points="359,54 367,59 359,64" fill="var(--code)"/>

  <!-- Box 4: CDN (code accent) -->
  <rect x="365" y="33" width="95" height="52" rx="5" stroke="var(--code)" stroke-width="1.5" fill="var(--bg-elevated)"/>
  <text x="413" y="64" text-anchor="middle" font-family="IBM Plex Mono,monospace" font-size="14" fill="var(--code)">CDN</text>
</svg>`,

  // Case C — Hotel reservations: legacy backend ← migration ← new frontend → grid component → internal library
  hotel: `<svg viewBox="0 0 480 180" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="diag-hotel-title diag-hotel-desc">
  <title id="diag-hotel-title">${isEn ? 'Hotel reservations platform architecture' : 'Arquitectura de la plataforma de reservaciones hoteleras'}</title>
  <desc id="diag-hotel-desc">${isEn ? 'A new frontend module migrated over a legacy backend in a single night with zero downtime. A high-density grid component extracted from the project was adopted into the client internal library.' : 'Un nuevo módulo de frontend se migró sobre un backend legacy en una sola noche sin downtime. Un componente de grid de alta densidad extraído del proyecto fue adoptado en la librería interna del cliente.'}</desc>

  <!-- Row 1: legacy ← migration arrow ← new frontend -->

  <!-- Legacy backend (greyed, dashed border = deprecated) -->
  <rect x="16" y="40" width="128" height="52" rx="5" stroke="var(--border-default)" stroke-width="1.5" stroke-dasharray="5 3" fill="var(--bg-surface)" opacity="0.7"/>
  <text x="80" y="62" text-anchor="middle" font-family="IBM Plex Mono,monospace" font-size="11" fill="var(--text-tertiary)">legacy</text>
  <text x="80" y="78" text-anchor="middle" font-family="IBM Plex Mono,monospace" font-size="11" fill="var(--text-tertiary)">backend</text>

  <!-- dashed arrow: from new frontend left edge (x=295) pointing left to legacy right edge (x=144) -->
  <line x1="144" y1="66" x2="295" y2="66" stroke="var(--coffee)" stroke-width="1.5" stroke-dasharray="4 3"/>
  <polygon points="148,61 140,66 148,71" fill="var(--coffee)"/>

  <!-- New frontend module -->
  <rect x="295" y="40" width="148" height="52" rx="5" stroke="currentColor" stroke-width="1.5" fill="var(--bg-elevated)"/>
  <text x="369" y="62" text-anchor="middle" font-family="IBM Plex Mono,monospace" font-size="11" fill="var(--text-primary)">${isEn ? 'new frontend' : 'nuevo frontend'}</text>
  <text x="369" y="78" text-anchor="middle" font-family="IBM Plex Mono,monospace" font-size="11" fill="var(--text-secondary)">module</text>

  <!-- connector: frontend → grid component -->
  <line x1="369" y1="92" x2="369" y2="114" stroke="currentColor" stroke-width="1.5"/>
  <polygon points="364,110 369,118 374,110" fill="currentColor"/>

  <!-- High-density grid component: x=196..464, center=330 -->
  <rect x="196" y="118" width="268" height="44" rx="5" stroke="currentColor" stroke-width="1.5" fill="var(--bg-elevated)"/>
  <text x="330" y="138" text-anchor="middle" font-family="IBM Plex Mono,monospace" font-size="11" fill="var(--text-secondary)">${isEn ? 'high-density grid' : 'grid alta densidad'}</text>
  <text x="330" y="153" text-anchor="middle" font-family="IBM Plex Mono,monospace" font-size="10" fill="var(--text-tertiary)">${isEn ? '(extracted component)' : '(componente extraído)'}</text>

  <!-- arrow: grid → internal library (leftward) -->
  <line x1="196" y1="140" x2="188" y2="140" stroke="var(--code)" stroke-width="1.5"/>
  <polygon points="192,135 184,140 192,145" fill="var(--code)"/>

  <!-- Internal library (code accent): x=16..184, center=100 -->
  <rect x="16" y="118" width="168" height="44" rx="5" stroke="var(--code)" stroke-width="1.5" fill="var(--bg-elevated)"/>
  <text x="100" y="138" text-anchor="middle" font-family="IBM Plex Mono,monospace" font-size="11" fill="var(--code)">${isEn ? 'internal library' : 'librería interna'}</text>
  <text x="100" y="153" text-anchor="middle" font-family="IBM Plex Mono,monospace" font-size="10" fill="var(--text-tertiary)">${isEn ? '(adopted upstream)' : '(adoptado upstream)'}</text>
</svg>`,
};

const cases = [
  {
    id: 'gov',
    titleEs: 'Gobierno municipal · Ciudad fronteriza · 250K habitantes',
    titleEn: 'Municipal government · Border city · 250K residents',
    bodyEs: 'Modernización digital completa de una administración municipal: app ciudadana con tickets y SLAs por dependencia, plataforma de compras con licitaciones, declaración patrimonial, control de corralón, y herramientas de transición de poderes. Diseñados para sobrevivir cambios de administración — operativos, no decorativos.',
    bodyEn: 'Full digital modernization of a municipal administration: citizen app with tickets and SLAs by department, procurement platform with tenders, asset disclosure, vehicle impound control, and government transition tools. Built to survive administration changes — operational, not decorative.',
    metricsEs: '8+ años en producción · Dos cambios de poder atravesados · Operados por personal interno.',
    metricsEn: '8+ years in production · Two administration changes navigated · Operated by internal staff.',
  },
  {
    id: 'ecom',
    titleEs: 'E-commerce de catálogos · Estados Unidos · Distribución nacional',
    titleEn: 'Catalog e-commerce · United States · National distribution',
    bodyEs: 'Sistema de visualización con detección automática de prendas y sobreposición realista de logos personalizados. Pipeline de procesamiento de imágenes en Python, arquitectura de microservicios sobre AWS.',
    bodyEn: 'Visualization system with automatic garment detection and realistic overlay of custom logos. Python image processing pipeline, microservices architecture on AWS.',
    metricsEs: 'En producción sin reescritura desde la entrega · Operación nacional ininterrumpida.',
    metricsEn: 'In production without rewrite since delivery · Uninterrupted national operation.',
  },
  {
    id: 'hotel',
    titleEs: 'Operador hotelero global · Plataforma de reservaciones',
    titleEn: 'Global hotel operator · Reservations platform',
    bodyEs: 'Modernización de UI sobre una aplicación legacy de reservaciones a gran escala. Migración del frontend en una sola noche, sin downtime ni regresión. Componente de grid de alta densidad desarrollado desde cero, adoptado por la librería interna oficial del cliente.',
    bodyEn: 'UI modernization over a large-scale legacy reservations application. Frontend migration in a single night, zero downtime, zero regression. High-density grid component built from scratch, adopted into the client\'s official internal library.',
    metricsEs: 'Componente vigente en librería corporativa · Uso transversal en productos guest-facing e internos.',
    metricsEn: 'Component active in corporate library · Used across guest-facing and internal products.',
  },
];

const statsEs = [
  { value: '8+', label: 'años · sistema más antiguo en producción' },
  { value: '3',  label: 'sectores en producción activa' },
  { value: '2',  label: 'mercados atendidos' },
  { value: '0',  label: 'reescrituras completas requeridas' },
];

const statsEn = [
  { value: '8+', label: 'years · oldest system still in production' },
  { value: '3',  label: 'sectors in active production' },
  { value: '2',  label: 'markets served' },
  { value: '0',  label: 'complete rewrites required' },
];
---

<section id="trabajo" class="section">
  <div class="container">
    <SectionHead
      lang={lang}
      num="§03"
      label="Trabajo bajo confidencialidad"
      labelEn="Work under confidentiality"
      title="Trabajo bajo confidencialidad."
      titleEn="Work under confidentiality."
      lede="La mayoría de nuestros clientes opera bajo NDA. Por eso no encontrarás logos en este sitio. Lo que sí podemos compartir está abajo: casos anonimizados con detalle técnico verificable."
      ledeEn="Most of our clients operate under NDA. That's why you won't find logos on this site. What we can share is below: anonymized cases with verifiable technical detail."
    />

    <!-- Case studies -->
    <div class="cw-cases">
      {cases.map((c) => (
        <article class="cw-case" id={`case-${c.id}`}>
          <!-- Case content: title + body + metrics -->
          <div class="cw-case-content">
            <h3 class="cw-case-title">{isEn ? c.titleEn : c.titleEs}</h3>
            <p class="cw-case-body">{isEn ? c.bodyEn : c.bodyEs}</p>
            <blockquote class="cw-case-metrics">{isEn ? c.metricsEn : c.metricsEs}</blockquote>
          </div>

          <!-- Diagram: full-width schematic below the case content -->
          <div class="cw-diagram" set:html={diagrams[c.id as keyof typeof diagrams]} />
        </article>
      ))}
    </div>

    <!-- Studio at a glance -->
    <div class="cw-stats-block">
      <p class="cw-stats-label t-mono-sm">
        {isEn ? 'Studio at a glance' : 'Estudio en cifras'}
      </p>
      <dl class="cw-stats">
        {(isEn ? statsEn : statsEs).map((s) => (
          <div class="cw-stat">
            <dd class="cw-stat-value">{s.value}</dd>
            <dt class="cw-stat-label">{s.label}</dt>
          </div>
        ))}
      </dl>
      <p class="cw-stats-note t-mono-sm">
        {isEn ? 'Verifiable references available under mutual confidentiality during discovery.' : 'Referencias verificables bajo confidencialidad recíproca en sesión de discovery.'}
      </p>
    </div>
  </div>
</section>

<style>
  /* ─── Case list ──────────────────────────────────────────── */
  .cw-cases {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-bottom: var(--space-16);
  }

  .cw-case {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    padding: var(--space-10) 0;
    border-top: 1px solid var(--border-subtle);
  }

  .cw-case:last-child {
    border-bottom: 1px solid var(--border-subtle);
  }

  /* ─── Diagram ────────────────────────────────────────────── */
  .cw-diagram {
    margin-top: var(--space-8);
    border-radius: var(--radius-md);
    background: var(--bg-base);
    border: 1px solid var(--border-subtle);
    overflow: hidden;
  }

  .cw-diagram svg {
    display: block;
    width: 100%;
    height: auto;
    padding: var(--space-6) var(--space-5);
  }

  /* ─── Case content ───────────────────────────────────────── */
  /* Mobile: single column, natural top-to-bottom flow */
  .cw-case-content {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
  }

  /* Desktop: title full-width top → body left · metrics right */
  @media (min-width: 960px) {
    .cw-case-content {
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
      grid-template-rows: auto auto;
      column-gap: var(--space-12);
      row-gap: var(--space-6);
    }

    /* Title anchors the card — spans full width */
    .cw-case-title {
      grid-column: 1 / -1;
      grid-row: 1;
    }

    /* Body is primary content — left, wider column */
    .cw-case-body {
      grid-column: 1;
      grid-row: 2;
      align-self: start;
    }

    /* Metrics is proof/credential — right, narrower column */
    .cw-case-metrics {
      grid-column: 2;
      grid-row: 2;
      align-self: start;
    }
  }

  .cw-case-title {
    font: 600 22px/1.25 var(--font-sans);
    color: var(--text-primary);
    letter-spacing: -0.02em;
    margin: 0;
    text-wrap: balance;
    padding-bottom: var(--space-5);
    border-bottom: 1px solid var(--border-subtle);
  }

  .cw-case-body {
    font: 400 15px/1.65 var(--font-sans);
    color: var(--text-secondary);
    margin: 0;
    text-wrap: pretty;
  }

  .cw-case-metrics {
    font: 400 13px/1.6 var(--font-mono);
    color: var(--text-tertiary);
    letter-spacing: -0.01em;
    margin: 0;
    padding: var(--space-4) var(--space-5);
    border-left: 2px solid var(--coffee);
    background: var(--bg-surface);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
  }

  /* ─── Stats block ────────────────────────────────────────── */
  .cw-stats-block {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    padding: var(--space-10) var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .cw-stats-label {
    margin: 0;
  }

  .cw-stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6) var(--space-8);
    margin: 0;
    padding: 0;
  }

  @media (min-width: 720px) {
    .cw-stats {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .cw-stat {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .cw-stat-value {
    font: 600 52px/1 var(--font-mono);
    color: var(--coffee);
    letter-spacing: -0.04em;
    margin: 0;
  }

  .cw-stat-label {
    font: 400 12px/1.4 var(--font-mono);
    color: var(--text-tertiary);
    letter-spacing: -0.01em;
    margin: 0;
  }

  .cw-stats-note {
    margin: 0;
    border-top: 1px solid var(--border-subtle);
    padding-top: var(--space-6);
  }
</style>
