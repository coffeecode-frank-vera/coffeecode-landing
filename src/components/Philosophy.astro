---
import '@styles/page.css';
import SectionHead from './SectionHead.astro';

const principles = [
  {
    num: '01',
    titleEs: 'El alcance se define, no se asume.',
    titleEn: 'Scope is defined, not assumed.',
    bodyEs: 'Diagnóstico técnico primero. El alcance emerge del problema, no de una propuesta genérica.',
    bodyEn: 'Technical diagnosis first. Scope follows from the problem, not from a generic proposal.',
  },
  {
    num: '02',
    titleEs: 'Visibilidad estructural desde el inicio.',
    titleEn: 'Structural visibility from the start.',
    bodyEs: 'Precio fijo, cronograma verificable, avance documentado. Sin ambigüedad presupuestaria.',
    bodyEn: 'Fixed price, verifiable timeline, documented progress. No budget ambiguity.',
  },
  {
    num: '03',
    titleEs: 'Calidad de producción como condición de entrega.',
    titleEn: 'Production quality as a delivery condition.',
    bodyEs: 'Código que opera bajo carga, gestiona fallos y escala. No se entrega si no está listo.',
    bodyEn: 'Code that operates under load, handles failures, and scales. Not shipped until it\'s ready.',
  },
  {
    num: '04',
    titleEs: 'Seguridad y observabilidad desde el primer commit.',
    titleEn: 'Security and observability from the first commit.',
    bodyEs: 'Análisis estático, trazabilidad de logs y controles de seguridad en la arquitectura desde el día uno.',
    bodyEn: 'Static analysis, log traceability, and security controls in the architecture from day one.',
  },
];
---

<section id="filosofia" class="section">
  <div class="container">
    <SectionHead
      num="§02"
      label="Filosofía"
      title="Cómo trabajamos"
      titleEn="How we work"
      lede="Cuatro compromisos operativos que rigen cada proyecto — desde el encuadre inicial hasta la estabilidad en producción."
      ledeEn="Four operational commitments that govern every engagement — from initial scoping through production stability."
    />

    <div class="philosophy">
      {principles.map((p) => (
        <article class={`principle principle-${p.num}`}>
          <p class="principle-num">
            <span class="principle-num-digits">{p.num}</span>
            <span class="principle-num-sep" aria-hidden="true"> /</span>
          </p>
          <h3 class="principle-title">
            <span class="lang-es">{p.titleEs}</span>
            <span class="lang-en">{p.titleEn}</span>
          </h3>
          <p class="principle-body">
            <span class="lang-es">{p.bodyEs}</span>
            <span class="lang-en">{p.bodyEn}</span>
          </p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  /*
    Scoped micro-detail styles for the Philosophy grid.
    Base layout stays in page.css — only card-level refinements here.
  */

  /* Card 01 gets a coffee-colored top accent to anchor the sequence visually.
     Two pixels is enough signal; anything heavier competes with the border-radius. */
  .principle-01 {
    border-top: 2px solid var(--coffee);
  }

  /* The number label on card 01 inherits the coffee accent.
     Cards 02–04 remain tertiary — the accent doesn't repeat. */
  .principle-01 .principle-num-digits {
    color: var(--coffee);
  }

  /* text-wrap: balance distributes line breaks evenly.
     Critical for title 04 ("Security and observability, not afterthoughts")
     which is nearly twice as long as the other titles. */
  :global(.principle-title) {
    text-wrap: balance;
  }

  /* Reduce horizontal padding on mobile so cards breathe without
     the content feeling cramped in a single column.
     Vertical padding stays at --space-8 (32px) — enough room. */
  @media (max-width: 600px) {
    :global(.principle) {
      padding: var(--space-8) var(--space-6);
    }
  }
</style>
