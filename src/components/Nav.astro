---
import '@styles/page.css';
import ThemeToggle from '@components/ThemeToggle.astro';
import LangToggle from '@components/LangToggle.astro';
import type { Lang } from '@layouts/Base.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const isEn = lang === 'en';
---

<header>
  <nav class="nav" aria-label={isEn ? 'Main navigation' : 'Navegación principal'}>
    <div class="nav-inner">

      <a href={isEn ? '/en/' : '/'} class="nav-logo" aria-label={isEn ? 'Coffee Code — home' : 'Coffee Code — inicio'}>
        <!-- Wordmark: desktop — inline SVG so fill responds to CSS variables -->
        <svg
          class="nav-logo-wordmark"
          viewBox="0 0 290 44"
          fill="none"
          aria-hidden="true"
          focusable="false"
        >
          <text
            x="8" y="32"
            font-family="'IBM Plex Mono', ui-monospace, monospace"
            font-size="28"
            font-weight="500"
          ><tspan fill="var(--brace)">{'{'}</tspan><tspan fill="var(--coffee)"> coffee</tspan><tspan fill="var(--syntax)">:</tspan><tspan fill="var(--code)"> code </tspan><tspan fill="var(--brace)">{'}'}</tspan></text>
        </svg>

        <!-- Mark: mobile — { cc } symbol only -->
        <svg
          class="nav-logo-mark"
          viewBox="0 20 200 60"
          fill="none"
          aria-hidden="true"
          focusable="false"
        >
          <path d="M 22 25 Q 12 25 12 35 L 12 46 Q 12 50 5 50 Q 12 50 12 54 L 12 65 Q 12 75 22 75" stroke="var(--brace)" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M 78.07 30.85 A 25 25 0 1 0 78.07 69.15" stroke="var(--coffee)" stroke-width="5.5" stroke-linecap="round"/>
          <circle cx="100" cy="35" r="4.5" fill="var(--syntax)"/>
          <circle cx="100" cy="65" r="4.5" fill="var(--syntax)"/>
          <path d="M 159.07 30.85 A 25 25 0 1 0 159.07 69.15" stroke="var(--code)" stroke-width="5.5" stroke-linecap="round"/>
          <path d="M 178 25 Q 188 25 188 35 L 188 46 Q 188 50 195 50 Q 188 50 188 54 L 188 65 Q 188 75 178 75" stroke="var(--brace)" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>

      <div class="nav-links" id="nav-links">
        <a href="#quienes-somos" class="nav-link">{isEn ? 'Who we are' : 'Quiénes somos'}</a>
        <a href="#filosofia" class="nav-link">{isEn ? 'Philosophy' : 'Filosofía'}</a>
        <a href="#trabajo" class="nav-link">{isEn ? 'Work' : 'Trabajo'}</a>
        <a href="#precios" class="nav-link">{isEn ? 'Pricing' : 'Precios'}</a>
        <a href="#contacto" class="btn btn-coffee nav-cta">{isEn ? 'Contact' : 'Contacto'}</a>
      </div>

      <div class="nav-actions">
        <LangToggle lang={lang} />
        <ThemeToggle />
        <button
          class="btn btn-ghost nav-hamburger"
          id="nav-hamburger"
          aria-expanded="false"
          aria-controls="nav-links"
          aria-label={isEn ? 'Open menu' : 'Abrir menú'}
          data-label-open={isEn ? 'Open menu' : 'Abrir menú'}
          data-label-close={isEn ? 'Close menu' : 'Cerrar menú'}
        >
          <svg width="18" height="14" viewBox="0 0 18 14" fill="none" aria-hidden="true" focusable="false">
            <rect y="0"  width="18" height="2" rx="1" fill="currentColor"/>
            <rect y="6"  width="18" height="2" rx="1" fill="currentColor"/>
            <rect y="12" width="18" height="2" rx="1" fill="currentColor"/>
          </svg>
        </button>
      </div>

    </div>
  </nav>
</header>

<style>
  .nav-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .nav-hamburger { display: none; }

  @media (max-width: 719px) {
    .nav-hamburger { display: inline-flex; padding: var(--space-2); }
    .nav-cta       { display: none; }

    .nav-links {
      display: none;
      flex-direction: column;
      align-items: stretch;
      position: absolute;
      top: 72px;
      left: 0;
      right: 0;
      background: var(--bg-base);
      border-bottom: 1px solid var(--border-subtle);
      padding: var(--space-3) var(--space-4) var(--space-5);
      gap: 0;
      z-index: var(--z-sticky);
    }

    .nav-links.is-open { display: flex; }

    .nav-link {
      width: 100%;
      padding: var(--space-3) var(--space-4);
    }
  }
</style>

<script>
  // Scroll-aware shadow
  const nav = document.querySelector('.nav') as HTMLElement;
  const sentinel = document.createElement('div');
  sentinel.style.cssText = 'position:absolute;top:0;height:1px;width:1px;pointer-events:none';
  document.body.prepend(sentinel);

  new IntersectionObserver(([entry]) => {
    nav.classList.toggle('is-scrolled', !entry.isIntersecting);
  }).observe(sentinel);

  // Active section highlighting
  const sections = document.querySelectorAll('section[id]');
  const navLinks = document.querySelectorAll('.nav-link[href^="#"]');

  const sectionObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          navLinks.forEach((link) => {
            link.classList.toggle('is-active', link.getAttribute('href') === `#${entry.target.id}`);
          });
        }
      });
    },
    { rootMargin: '-30% 0px -60% 0px' }
  );

  sections.forEach((s) => sectionObserver.observe(s));

  // Mobile hamburger toggle
  const hamburger = document.getElementById('nav-hamburger') as HTMLButtonElement;
  const navLinksEl = document.getElementById('nav-links') as HTMLElement;

  const labelOpen  = hamburger.dataset.labelOpen  ?? 'Abrir menú';
  const labelClose = hamburger.dataset.labelClose ?? 'Cerrar menú';

  hamburger.addEventListener('click', () => {
    const isOpen = navLinksEl.classList.toggle('is-open');
    hamburger.setAttribute('aria-expanded', String(isOpen));
    hamburger.setAttribute('aria-label', isOpen ? labelClose : labelOpen);
  });

  // Close menu when a link is clicked
  navLinksEl.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      navLinksEl.classList.remove('is-open');
      hamburger.setAttribute('aria-expanded', 'false');
      hamburger.setAttribute('aria-label', labelOpen);
    });
  });
</script>
