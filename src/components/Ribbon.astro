---
import '@styles/page.css';
import type { Lang } from '@layouts/Base.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const isEn = lang === 'en';

const services = [
  {
    num: '01',
    titleEs: 'Landings y sitios',
    titleEn: 'Landings and sites',
    bodyEs: 'Rápidas, bien construidas, entregadas. Precio fijo, alcance definido.',
    bodyEn: 'Fast, well-built, delivered. Fixed price, defined scope.',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="12" y2="17"/></svg>`,
  },
  {
    num: '02',
    titleEs: 'Software empresarial',
    titleEn: 'Enterprise software',
    bodyEs: 'Full stack de extremo a extremo. Para equipos que pagan lo que vale y exigen que funcione.',
    bodyEn: 'Full stack end to end. For teams that pay what it costs and demand it works.',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 2L22 7L12 12L2 7z"/><path d="M2 12l10 5 10-5"/><path d="M2 17l10 5 10-5"/></svg>`,
  },
  {
    num: '03',
    titleEs: 'Rescate y consultoría',
    titleEn: 'Recovery and consulting',
    bodyEs: 'Deuda técnica, arquitectura rota, equipo quemado. Diagnóstico real, solución real.',
    bodyEn: 'Technical debt, broken architecture, burned team. Real diagnosis, real fix.',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>`,
  },
  {
    num: '04',
    titleEs: 'Librerías internas',
    titleEn: 'Internal libraries',
    bodyEs: 'Componentes y paquetes custom para ingenieros que no reinventan lo mismo dos veces.',
    bodyEn: "Custom components and packages for engineers who don't solve the same problem twice.",
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/><line x1="16.5" y1="9.4" x2="7.5" y2="4.21"/></svg>`,
  },
];
---

<div class="ribbon">
  <p class="ribbon-transition">
    {isEn ? 'Four ways to work with us. Four ways to solve.' : 'Cuatro formas de trabajar con nosotros. Cuatro maneras de resolver.'}
  </p>
  {services.map((s) => (
    <div class="ribbon-cell">
      <div class="ribbon-meta">
        <span class="ribbon-icon" set:html={s.icon} />
        <span class="ribbon-num">{s.num} /</span>
      </div>
      <p class="ribbon-title">{isEn ? s.titleEn : s.titleEs}</p>
      <p class="ribbon-body">{isEn ? s.bodyEn : s.bodyEs}</p>
    </div>
  ))}
</div>

<style>
  .ribbon-meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .ribbon-icon {
    display: flex;
    align-items: center;
    width: 20px;
    height: 20px;
    color: var(--coffee);
    flex-shrink: 0;
  }

  .ribbon-icon svg {
    width: 20px;
    height: 20px;
    display: block;
  }

  .ribbon-transition {
    grid-column: 1 / -1;
    font: 400 13px/1.4 var(--font-mono);
    color: var(--text-tertiary);
    letter-spacing: -0.01em;
    margin: 0;
    padding: var(--space-4) var(--space-6);
    text-align: center;
    border-bottom: 1px solid var(--border-subtle);
  }
</style>
