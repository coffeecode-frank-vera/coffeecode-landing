---
import '@styles/page.css';
import type { Lang } from '@layouts/Base.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const isEn = lang === 'en';

const headline     = isEn ? 'Software for companies where the code matters.'            : 'Software para empresas donde el código importa.';
const sub1         = isEn ? 'We build systems that ship to production and stay there.'  : 'Construimos sistemas que llegan a producción y se quedan.';
const sub2         = isEn ? "It's not cheap. That's what doing it right costs."         : 'No es barato. Es lo que cuesta hacerlo bien.';
const ctaLabel     = isEn ? 'Talk about your project'                                   : 'Hablemos del proyecto';
const metaLabel    = isEn ? 'Studio data'                                               : 'Datos del estudio';
const stackVal     = isEn ? 'Stack chosen for the problem. TS, C#, Postgres by default.' : 'Stack elegido por el problema. TS, C#, Postgres por defecto.';
---

<section id="inicio" class="hero" aria-labelledby="hero-headline">
  <div class="container">
    <div class="hero-grid">

      <!-- Left: statement + CTAs -->
      <div class="hero-left">

        <!-- Wordmark: mobile only -->
        <svg
          class="hero-wordmark"
          viewBox="0 0 290 44"
          fill="none"
          aria-label="Coffee Code"
          role="img"
        >
          <text
            x="8" y="32"
            font-family="'IBM Plex Mono', ui-monospace, monospace"
            font-size="28"
            font-weight="500"
          ><tspan fill="var(--brace)">{'{'}</tspan><tspan fill="var(--coffee)"> coffee</tspan><tspan fill="var(--syntax)">:</tspan><tspan fill="var(--code)"> code </tspan><tspan fill="var(--brace)">{'}'}</tspan></text>
        </svg>

        <p class="hero-eyebrow">
          Software studio · Nogales, Sonora, México
        </p>

        <h1 id="hero-headline">{headline}</h1>

        <p class="hero-sub">
          {sub1}<br class="hero-sub-br" /> {sub2}
        </p>

        <div class="hero-cta">
          <a href="#contacto" class="btn btn-coffee">{ctaLabel}</a>
        </div>
      </div>

      <!-- Right: animated terminal -->
      <aside class="hero-terminal" aria-label={metaLabel} aria-hidden="true">
        <div class="term-bar">
          <span class="term-dot" style="background:#FF5F57"></span>
          <span class="term-dot" style="background:#FFBD2E"></span>
          <span class="term-dot" style="background:#28C840"></span>
          <span class="term-title">{'{ coffee: code }'}</span>
        </div>
        <div class="term-body">
          <p class="term-line term-prompt">$ npm run deploy:prod</p>
          <p class="term-line term-dim">  ▸ compiling 3 routes…</p>
          <p class="term-line term-dim">  ▸ running checks…</p>
          <p class="term-line term-success">  ✓ deployed · 2 regions · 47ms</p>
          <p class="term-line term-blank"> </p>
          <p class="term-line term-comment">  // stack chosen for the problem</p>
          <p class="term-line term-key">  const tech = {'{'}</p>
          <p class="term-line term-obj"><span class="term-prop">api</span>: <span class="term-str">'ts + fastify'</span>,</p>
          <p class="term-line term-obj"><span class="term-prop">db</span>: <span class="term-str">'postgres 16'</span>,</p>
          <p class="term-line term-obj"><span class="term-prop">infra</span>: <span class="term-str">'AWS'</span>,</p>
          <p class="term-line term-key">  {'}'}</p>
          <p class="term-line term-cursor-line">
            <span class="term-ps">$</span><span class="term-cursor">▊</span>
          </p>
        </div>
      </aside>

    </div>
  </div>
</section>

<style>
  /* ─── Wordmark (mobile only) ────────────────────────── */
  .hero-wordmark {
    display: none;
  }

  @media (max-width: 719px) {
    .hero-wordmark {
      display: block;
      height: 32px;
      width: auto;
      margin-inline: auto;
      margin-bottom: var(--space-6);
    }

    .hero-eyebrow {
      justify-content: center;
    }
  }

  /* ─── Subhead line break ────────────────────────────── */
  .hero-sub-br {
    display: none;
  }

  @media (min-width: 720px) {
    .hero-sub-br {
      display: block;
    }
  }

  /* ─── Terminal ──────────────────────────────────────── */
  .hero-terminal {
    font: 400 12.5px/1.65 var(--font-mono);
    background: var(--bg-elevated);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
    overflow: hidden;
    align-self: center;
  }

  .term-bar {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--border-subtle);
    background: var(--bg-surface);
  }

  .term-dot {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--border-default);
  }

  .term-title {
    font-size: 11px;
    color: var(--text-tertiary);
    margin-left: var(--space-2);
    letter-spacing: 0.02em;
  }

  .term-body {
    padding: var(--space-5) var(--space-5) var(--space-6);
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .term-line {
    margin: 0;
    color: var(--text-secondary);
    opacity: 0;
    animation: termReveal 0.12s ease-out forwards;
    white-space: pre;
  }

  .term-line:nth-child(1) { animation-delay: 0.25s; }
  .term-line:nth-child(2) { animation-delay: 0.55s; }
  .term-line:nth-child(3) { animation-delay: 0.95s; }
  .term-line:nth-child(4) { animation-delay: 1.4s; }
  .term-line:nth-child(5) { animation-delay: 1.65s; }
  .term-line:nth-child(6) { animation-delay: 1.8s; }
  .term-line:nth-child(7) { animation-delay: 2.0s; }
  .term-line:nth-child(8) { animation-delay: 2.15s; }
  .term-line:nth-child(9) { animation-delay: 2.3s; }
  .term-line:nth-child(10) { animation-delay: 2.45s; }
  .term-line:nth-child(11) { animation-delay: 2.6s; }
  .term-cursor-line { animation-delay: 2.8s !important; }

  .term-prompt { color: var(--text-primary); }
  .term-dim    { color: var(--text-tertiary); }
  .term-success { color: var(--code); }
  .term-comment { color: var(--text-tertiary); font-style: italic; }
  .term-key    { color: var(--text-secondary); }
  .term-obj    { color: var(--text-secondary); padding-left: 2ch; }
  .term-prop   { color: var(--code); }
  .term-str    { color: var(--coffee); }
  .term-blank  { min-height: 0.6em; }

  .term-cursor-line {
    display: flex;
    align-items: baseline;
    gap: 2px;
    margin-top: 2px;
  }

  .term-ps {
    color: var(--text-tertiary);
  }

  .term-cursor {
    color: var(--coffee);
    animation: blink 1s step-end infinite;
    animation-delay: 2.8s;
    opacity: 0;
  }

  @keyframes termReveal {
    from { opacity: 0; transform: translateY(3px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0; }
  }

  /* Mobile: single column, terminal after headline */
  @media (max-width: 719px) {
    :global(.hero-grid) {
      grid-template-columns: 1fr;
    }

    .hero-terminal {
      font-size: 11.5px;
      overflow-x: auto;
    }
  }

  /* Reduce motion: reveal all lines instantly, no blink */
  @media (prefers-reduced-motion: reduce) {
    .term-line,
    .term-cursor {
      opacity: 1 !important;
      animation: none !important;
      transform: none !important;
    }
  }
</style>
