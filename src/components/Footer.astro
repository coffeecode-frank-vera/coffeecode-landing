---
import '@styles/page.css';
import type { Lang } from '@layouts/Base.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const isEn = lang === 'en';
---

<footer class="foot" aria-label={isEn ? 'Footer' : 'Pie de página'}>
  <div class="container">
    <div class="foot-grid">

      <!-- Brand block -->
      <div class="foot-col foot-brand">
        <a href={isEn ? '/en/' : '/'} aria-label={isEn ? 'Coffee Code — home' : 'Coffee Code — inicio'}>
          <svg
            class="foot-wordmark"
            viewBox="0 0 290 44"
            fill="none"
            aria-hidden="true"
            focusable="false"
          >
            <text
              x="8" y="32"
              font-family="'IBM Plex Mono', ui-monospace, monospace"
              font-size="28"
              font-weight="500"
            ><tspan fill="var(--brace)">{'{'}</tspan><tspan fill="var(--coffee)"> coffee</tspan><tspan fill="var(--syntax)">:</tspan><tspan fill="var(--code)"> code </tspan><tspan fill="var(--brace)">{'}'}</tspan></text>
          </svg>
        </a>
        <p class="foot-tagline">
          {isEn ? 'Software studio. Systems that ship and stay.' : 'Software studio. Sistemas que llegan a producción y se quedan.'}
        </p>
        <p class="foot-copy">&copy; {new Date().getFullYear()} Coffee Code</p>
      </div>

      <!-- Studio links -->
      <nav class="foot-col" aria-label={isEn ? 'Site sections' : 'Secciones del sitio'}>
        <h4>{isEn ? 'Studio' : 'Estudio'}</h4>
        <a href="#quienes-somos">{isEn ? 'About' : 'Nosotros'}</a>
        <a href="#filosofia">{isEn ? 'Philosophy' : 'Filosofía'}</a>
        <a href="#trabajo">{isEn ? 'Work' : 'Trabajo'}</a>
        <a href="#precios">{isEn ? 'Pricing' : 'Precios'}</a>
        <a href="#contacto">{isEn ? 'Contact' : 'Contacto'}</a>
      </nav>

    </div>

    <div class="foot-bottom">
      <span>coffeecode.com.mx</span>
      <span>Nogales, Sonora, México</span>
    </div>
  </div>
</footer>

<style>
  .foot-wordmark {
    height: 24px;
    width: auto;
    display: block;
    margin-bottom: var(--space-4);
  }

  .foot-tagline {
    font: 400 14px/1.6 var(--font-sans);
    color: var(--text-secondary);
    margin: 0 0 var(--space-4);
    max-width: 30ch;
  }

  .foot-copy {
    font: 400 12px/1 var(--font-mono);
    color: var(--text-tertiary);
    margin: 0;
  }

</style>
