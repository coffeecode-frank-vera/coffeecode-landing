---
import type { Lang } from '@layouts/Base.astro';

interface Props {
  lang: Lang;
  num: string;
  label: string;
  labelEn?: string;
  title: string;
  titleEn?: string;
  lede?: string;
  ledeEn?: string;
}

const { lang, num, label, labelEn, title, titleEn, lede, ledeEn } = Astro.props;
const isEn = lang === 'en';

const resolvedLabel = isEn && labelEn ? labelEn : label;
const resolvedTitle = isEn && titleEn ? titleEn : title;
const resolvedLede  = isEn && ledeEn  ? ledeEn  : lede;
---

<div class="section-head">
  <div>
    <p class="section-num"><strong>{num}</strong> — {resolvedLabel}</p>
  </div>
  <div>
    <h2 class="section-title">{resolvedTitle}</h2>
    {resolvedLede && <p class="section-lede">{resolvedLede}</p>}
  </div>
</div>
