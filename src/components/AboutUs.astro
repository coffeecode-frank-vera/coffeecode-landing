---
import '@styles/page.css';
import SectionHead from '@components/SectionHead.astro';

const bullets = [
  {
    es: 'Más de una década construyendo sistemas reales — con resiliencia, observabilidad, y el criterio para saber qué no construir.',
    en: 'Over a decade building real systems — with resilience, observability, and the judgment to know what not to build.',
  },
  {
    es: 'Trabajamos en español e inglés con la misma fluidez — la comunicación no se convierte en un factor de riesgo.',
    en: 'We work in Spanish and English with equal fluency — communication doesn\'t become a risk factor.',
  },
  {
    es: 'Sin formularios de doce campos, sin discovery de dos semanas antes de ver una propuesta. Entendemos el problema, lo convertimos en código.',
    en: 'No twelve-field intake forms, no two-week discovery phase before you see a proposal. We understand the problem, turn it into code.',
  },
];
---

<section id="quienes-somos" class="section">
  <div class="container">
    <SectionHead
      num="§01"
      label="Quiénes somos"
      title="Software que llega a producción y se queda."
      titleEn="Software that ships to production and stays there."
      lede="Somos un estudio de ingeniería. No una agencia, no un equipo rotativo. Las mismas personas de principio a fin."
      ledeEn="We are an engineering studio. Not an agency, not a rotating team. The same people from start to finish."
    />

    <div class="about-grid">
      <!-- Opening paragraph -->
      <p class="about-intro">
        <span class="lang-es">Cada sistema que construimos está diseñado para el mundo real: bajo carga, con fallos parciales, mantenido por equipos. La precisión no es una preferencia estética — es la diferencia entre un sistema con tolerancia a fallos y uno sin ella.</span>
        <span class="lang-en">Every system we build is designed for the real world: under load, with partial failures, maintained by teams. Precision isn't an aesthetic preference — it's the difference between a system with fault tolerance and one without.</span>
      </p>

      <!-- Three surface bullets -->
      <ul class="about-bullets" aria-label="Puntos clave / Key points">
        {bullets.map((b) => (
          <li class="about-bullet">
            <span class="about-bullet-mark" aria-hidden="true">—</span>
            <span class="about-bullet-text">
              <span class="lang-es">{b.es}</span>
              <span class="lang-en">{b.en}</span>
            </span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
    max-width: 72ch;
  }

  .about-intro {
    font: 400 17px/1.65 var(--font-sans);
    color: var(--text-secondary);
    margin: 0;
    text-wrap: pretty;
  }

  /* ─── Bullets ─────────────────────────────────────── */
  .about-bullets {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .about-bullet {
    display: grid;
    grid-template-columns: 20px minmax(0, 1fr);
    gap: var(--space-4);
    padding: var(--space-6) 0;
    border-top: 1px solid var(--border-subtle);
    align-items: baseline;
  }

  .about-bullet:last-child {
    border-bottom: 1px solid var(--border-subtle);
  }

  .about-bullet-mark {
    font: 400 14px/1 var(--font-mono);
    color: var(--coffee);
    user-select: none;
  }

  .about-bullet-text {
    font: 400 15px/1.65 var(--font-sans);
    color: var(--text-secondary);
    text-wrap: pretty;
  }
</style>
