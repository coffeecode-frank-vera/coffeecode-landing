---
import type { Lang } from '@layouts/Base.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const isEn = lang === 'en';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const esHref = `${base}/`;
const enHref = `${base}/en/`;
---

<nav class="lang-switcher" aria-label={isEn ? 'Language' : 'Idioma'}>
  <a
    href={esHref}
    class:list={['lt-opt', { 'is-active': !isEn }]}
    aria-current={!isEn ? 'page' : undefined}
    hreflang="es"
    lang="es"
  >ES</a>
  <span class="lt-sep" aria-hidden="true">/</span>
  <a
    href={enHref}
    class:list={['lt-opt', { 'is-active': isEn }]}
    aria-current={isEn ? 'page' : undefined}
    hreflang="en"
    lang="en"
  >EN</a>
</nav>

<style>
  .lang-switcher {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    font: 500 12px/1 var(--font-mono);
    letter-spacing: 0.05em;
  }

  .lt-sep {
    color: var(--border-default);
  }

  .lt-opt {
    color: var(--text-tertiary);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition:
      color var(--dur-fast) var(--ease-out),
      background var(--dur-fast) var(--ease-out);
  }

  .lt-opt.is-active {
    color: var(--text-primary);
    background: var(--bg-elevated);
    font-weight: 600;
  }

  .lt-opt:hover:not(.is-active) {
    color: var(--text-secondary);
  }
</style>
