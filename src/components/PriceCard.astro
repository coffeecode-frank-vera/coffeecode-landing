---
import '@styles/pricing.css';
import type { Lang } from '@layouts/Base.astro';

interface Props {
  lang: Lang;
  name: string;
  sub: string;
  subEn?: string;
  price: string;
  priceEn?: string;
  priceNote: string;
  priceNoteEn?: string;
  featured?: boolean;
  isCustom?: boolean;
  cta: string;
  ctaEn?: string;
  body?: string;
  bodyEn?: string;
  features: string[];
  featuresEn?: string[];
}

const {
  lang,
  name, sub, subEn, price, priceEn, priceNote, priceNoteEn,
  featured = false, isCustom = false,
  cta, ctaEn, body, bodyEn, features, featuresEn,
} = Astro.props;

const isEn = lang === 'en';

const resolvedSub       = isEn && subEn       ? subEn       : sub;
const resolvedPrice     = isEn && priceEn     ? priceEn     : price;
const resolvedPriceNote = isEn && priceNoteEn ? priceNoteEn : priceNote;
const resolvedBody      = isEn && bodyEn      ? bodyEn      : body;
const resolvedCta       = isEn && ctaEn       ? ctaEn       : cta;
const resolvedFeatures  = isEn && featuresEn  ? featuresEn  : features;
const badgeLabel        = isEn ? 'Most popular' : 'Más elegido';
---

<div class:list={['price-card', { 'is-featured': featured, 'price-custom': isCustom }]}>
  {featured && <span class="price-badge">{badgeLabel}</span>}

  <div>
    <p class="price-name">{name}</p>
    <p class="price-sub">{resolvedSub}</p>
  </div>

  <div class="price-amount">
    <span class="price-num">{resolvedPrice}</span>
    <span class="price-note">{resolvedPriceNote}</span>
  </div>

  {isCustom && resolvedBody && (
    <p class="price-custom-body">{resolvedBody}</p>
  )}

  <ul class="price-list">
    {resolvedFeatures.map((f) => (
      <li>
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M13.5 4.5L6.5 11.5L3 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        {f}
      </li>
    ))}
  </ul>

  <a href="#contacto" class:list={['btn', featured ? 'btn-coffee' : 'btn-secondary', 'price-cta']}>
    {resolvedCta}
  </a>
</div>
